{
  "type": "object",
  "properties": {
    "schema_version": {"const": "0.1"},
    "project_id": {"type": "string","pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "revision": {"type": "integer","minimum": 0},
    "as_of": {"type": "string","format": "date-time"},
    "objective": {"type":"object","properties":{"id":{"type":"string","minLength":1,"maxLength":500},"version":{"type":"integer","minimum":1},"statement":{"type":"string","minLength":1,"maxLength":10000}},"required":["id","version","statement"],"additionalProperties":false},
    "criteria": {"type":"array","items":{"$ref":"#/$defs/criterion"},"minItems":1},
    "control": {"type":"object","properties":{"mode":{"enum":["advisory","bounded"]},"controller_id":{"type":"string","minLength":1,"maxLength":500},"allowed_action_classes":{"type":"array","items":{"enum":["inspect","local_edit","local_compute"]},"minItems":1,"uniqueItems":true},"max_actions":{"type":"integer","minimum":0,"maximum":10000},"actions_used":{"type":"integer","minimum":0,"maximum":10000},"invariants":{"type":"array","items":{"type":"string","minLength":1,"maxLength":10000},"minItems":1}},"required":["mode","controller_id","allowed_action_classes","max_actions","actions_used","invariants"],"additionalProperties":false},
    "questions": {"type":"array","items":{"$ref":"#/$defs/question"},"minItems":0},
    "evidence": {"type":"array","items":{"$ref":"#/$defs/evidence"},"minItems":0},
    "pending_effects": {"type":"array","items":{"$ref":"#/$defs/pending"},"minItems":0},
    "decisions": {"type":"array","items":{"$ref":"#/$defs/decision"},"minItems":0},
    "handoff": {"$ref":"#/$defs/handoff"},
    "history": {"type":"array","items":{"$ref":"#/$defs/history"},"minItems":0}
  },
  "required":["schema_version","project_id","revision","as_of","objective","criteria","control","questions","evidence","pending_effects","decisions","handoff","history"],
  "additionalProperties":false,
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:cpc:state:0.1",
  "title":"CPC 0.1 reference state (not scientific truth)",
  "description":"Optional file-backed adapter snapshot. Core policy is backend-neutral.",
  "$defs":{
    "evidence":{"type":"object","properties":{"id":{"type":"string","pattern":"^E-[A-Za-z0-9][A-Za-z0-9._-]*$","maxLength":100},"summary":{"type":"string","minLength":1,"maxLength":10000},"observed_at":{"type":"string","format":"date-time"},"objective_version":{"type":"integer","minimum":1},"targets":{"type":"array","items":{"type":"string","minLength":1,"maxLength":500},"minItems":1,"uniqueItems":true},"relation":{"enum":["supports","contradicts","inconclusive"]},"validity":{"enum":["current","stale","retracted"]},"validity_reason":{"type":["string","null"],"minLength":1,"maxLength":1000},"review_status":{"enum":["unreviewed","reviewed"]},"reviewer":{"type":["string","null"],"minLength":1,"maxLength":1000},"review_note":{"type":"string","minLength":1,"maxLength":10000},"limitations":{"type":"array","items":{"type":"string","minLength":1,"maxLength":10000},"minItems":0},"provenance":{"type":"object","properties":{"producer":{"type":"string","minLength":1,"maxLength":500},"run_ref":{"type":"string","minLength":1,"maxLength":500},"input_ref":{"type":"string","minLength":1,"maxLength":500}},"required":["producer","run_ref","input_ref"],"additionalProperties":false},"artifacts":{"type":"array","items":{"type":"object","properties":{"path":{"type":"string","minLength":1,"maxLength":2000},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}},"required":["path","sha256"],"additionalProperties":false},"minItems":1},"depends_on":{"type":"array","items":{"type":"string","pattern":"^E-[A-Za-z0-9][A-Za-z0-9._-]*$","maxLength":100},"minItems":0,"uniqueItems":true}},"required":["id","summary","observed_at","objective_version","targets","relation","validity","validity_reason","review_status","reviewer","review_note","limitations","provenance","artifacts","depends_on"],"additionalProperties":false},
    "criterion":{"type":"object","properties":{"id":{"type":"string","pattern":"^C-[A-Za-z0-9][A-Za-z0-9._-]*$","maxLength":100},"description":{"type":"string","minLength":1,"maxLength":10000},"category":{"enum":["knowledge","delivery","safety"]},"status":{"enum":["unknown","supported","contradicted"]},"evidence_ids":{"type":"array","items":{"type":"string","pattern":"^E-[A-Za-z0-9][A-Za-z0-9._-]*$","maxLength":100},"minItems":0,"uniqueItems":true}},"required":["id","description","category","status","evidence_ids"],"additionalProperties":false},
    "question":{"type":"object","properties":{"id":{"type":"string","pattern":"^Q-[A-Za-z0-9][A-Za-z0-9._-]*$","maxLength":100},"description":{"type":"string","minLength":1,"maxLength":10000},"blocks":{"type":"array","items":{"type":"string","pattern":"^C-[A-Za-z0-9][A-Za-z0-9._-]*$","maxLength":100},"minItems":1,"uniqueItems":true},"status":{"enum":["open","resolved"]},"evidence_ids":{"type":"array","items":{"type":"string","pattern":"^E-[A-Za-z0-9][A-Za-z0-9._-]*$","maxLength":100},"minItems":0,"uniqueItems":true}},"required":["id","description","blocks","status","evidence_ids"],"additionalProperties":false},
    "pending":{"type":"object","properties":{"id":{"type":"string","pattern":"^P-[A-Za-z0-9][A-Za-z0-9._-]*$","maxLength":100},"description":{"type":"string","minLength":1,"maxLength":10000},"task_ref":{"type":"string","minLength":1,"maxLength":500},"owner":{"type":"string","minLength":1,"maxLength":500},"expected_at":{"type":"string","format":"date-time"},"timeout_at":{"type":"string","format":"date-time"},"status":{"enum":["waiting","received","failed","cancelled"]}},"required":["id","description","task_ref","owner","expected_at","timeout_at","status"],"additionalProperties":false},
    "decision":{"type":"object","properties":{"id":{"type":"string","pattern":"^D-[A-Za-z0-9][A-Za-z0-9._-]*$","maxLength":100},"summary":{"type":"string","minLength":1,"maxLength":10000},"rationale":{"type":"string","minLength":1,"maxLength":10000},"alternatives":{"type":"array","items":{"type":"string","minLength":1,"maxLength":10000},"minItems":1},"evidence_ids":{"type":"array","items":{"type":"string","pattern":"^E-[A-Za-z0-9][A-Za-z0-9._-]*$","maxLength":100},"minItems":0,"uniqueItems":true},"revisit_when":{"type":"string","minLength":1,"maxLength":10000},"supersedes":{"anyOf":[{"type":"string","pattern":"^D-[A-Za-z0-9][A-Za-z0-9._-]*$","maxLength":100},{"type":"null"}]}},"required":["id","summary","rationale","alternatives","evidence_ids","revisit_when","supersedes"],"additionalProperties":false},
    "handoff":{"type":"object","properties":{"summary":{"type":"string","minLength":1,"maxLength":10000},"next_action":{"type":"string","minLength":1,"maxLength":10000},"open_risks":{"type":"array","items":{"type":"string","minLength":1,"maxLength":10000},"minItems":0},"do_not_repeat":{"type":"array","items":{"type":"string","minLength":1,"maxLength":10000},"minItems":0}},"required":["summary","next_action","open_risks","do_not_repeat"],"additionalProperties":false},
    "history":{"type":"object","properties":{"id":{"type":"string","pattern":"^T-[A-Za-z0-9][A-Za-z0-9._-]*$","maxLength":100},"base_revision":{"type":"integer","minimum":0},"new_revision":{"type":"integer","minimum":1},"mode":{"enum":["observe","act","wait","escalate","stop"]},"actor":{"type":"string","minLength":1,"maxLength":500},"at":{"type":"string","format":"date-time"},"receipt_path":{"type":"string","minLength":1,"maxLength":500},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"summary":{"type":"string","minLength":1,"maxLength":10000}},"required":["id","base_revision","new_revision","mode","actor","at","receipt_path","sha256","summary"],"additionalProperties":false}
  }
}
